# Copia este archivo a .env y completa los valores (local)
# En la nube (Render/Railway) se configuran como variables de entorno.

# Puerto del servidor (en la nube lo asigna la plataforma)
PORT=3001

# URI de MongoDB Atlas (M0 gratis). Deja vacío para usar JSON local.
MONGO_URI=

# Nombre de la base de datos
MONGO_DB=proyecto7

# WhatsApp del trío con código de país y sin "+" ni espacios, ej: 529991234567
WHATSAPP_NUM=529990000000
