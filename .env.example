# Configuración del servidor Node de Proyecto 7. No publicar el archivo .env real.
PORT=3001
NODE_ENV=production

# MongoDB Atlas: obligatorio para fotografía persistente; sin esto la galería no acepta cargas.
MONGO_URI=
MONGO_DB=proyecto7

# Clave aleatoria de alta entropía, mínimo 32 caracteres (NO copiar un ejemplo público).
JWT_SECRET=

# Acceso Basic existente del panel /admin/leads
ADMIN_USER=admin
ADMIN_PASSWORD=

# Contraseñas iniciales SOLO cuando se crea una base nueva (deben ser únicas).
SEED_ELIAS_PASSWORD=
SEED_AURORA_PASSWORD=
SEED_RULO_PASSWORD=

# Configuración comercial. Sustituye el número de muestra.
WHATSAPP_NUM=

# En GitHub Pages: configurar el contenido de meta[name="proyecto7-galeria-api"]
# con la URL HTTPS pública del servidor desplegado (sin / al final).
