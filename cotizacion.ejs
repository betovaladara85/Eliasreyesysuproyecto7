<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Tu cotización · Elías Reyes y su Proyecto 7</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,700&family=Work+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    :root{
      --sol:#FFC93C;
      --sol-suave:#FFE39B;
      --rosa:#E0457B;
      --rosa-osc:#A82E58;
      --turquesa:#00A9A5;
      --turquesa-osc:#067572;
      --cacao:#3D2400;
      --cacao-suave:#6B4423;
      --hueso:#FFFAF0;
      --crema:#FFF3D6;
      --linea: rgba(61,36,0,0.14);
      --display:'Fraunces', serif;
      --cuerpo:'Work Sans', sans-serif;
    }
    *{margin:0;padding:0;box-sizing:border-box;}
    body{
      background:var(--hueso);
      color:var(--cacao);
      font-family:var(--cuerpo);
      line-height:1.6;
      min-height:100vh;
      display:flex;
      flex-direction:column;
      align-items:center;
      padding:32px 16px 48px;
    }
    .tarjeta{
      width:100%;
      max-width:680px;
      background:#fff;
      border:3px solid var(--cacao);
      border-radius:20px;
      overflow:hidden;
      box-shadow:0 18px 50px rgba(61,36,0,0.18);
    }
    .cabecera{
      background:linear-gradient(150deg, var(--cacao), #5a3510);
      color:var(--hueso);
      padding:34px 34px 28px;
      text-align:center;
    }
    .cabecera .marca{
      display:inline-block;
      font-size:0.7rem;
      letter-spacing:0.18em;
      text-transform:uppercase;
      color:var(--sol);
      font-weight:700;
      margin-bottom:10px;
    }
    .cabecera h1{
      font-family:var(--display);
      font-size:2rem;
      font-weight:700;
      line-height:1.05;
    }
    .cabecera .subtitulo{
      margin-top:8px;
      font-size:0.9rem;
      color:var(--sol-suave);
    }
    .folio{
      margin-top:18px;
      display:inline-block;
      background:var(--sol);
      color:var(--cacao);
      font-weight:700;
      font-size:0.78rem;
      letter-spacing:0.06em;
      padding:6px 16px;
      border-radius:50px;
    }
    .cuerpo{padding:30px 34px 34px;}
    .etiqueta{
      font-size:0.7rem;
      text-transform:uppercase;
      letter-spacing:0.12em;
      color:var(--cacao-suave);
      font-weight:700;
      margin-bottom:4px;
    }
    .servicio{
      display:flex;
      align-items:center;
      gap:14px;
      background:var(--crema);
      border:2px solid var(--cacao);
      border-radius:16px;
      padding:18px 20px;
      margin-bottom:24px;
    }
    .servicio .icono{
      width:46px;height:46px;flex-shrink:0;
      border-radius:12px;
      display:flex;align-items:center;justify-content:center;
      font-size:1.5rem;
      background:var(--sol-suave);
      border:2px solid var(--cacao);
    }
    .servicio .nombre{font-family:var(--display);font-size:1.35rem;font-weight:700;}
    .servicio .detalle-rapido{font-size:0.85rem;color:var(--cacao-suave);}
    .fila-detalle{
      display:flex;
      justify-content:space-between;
      gap:16px;
      padding:12px 0;
      border-bottom:1px dashed var(--linea);
    }
    .fila-detalle:last-child{border-bottom:none;}
    .fila-detalle .clave{font-size:0.88rem;color:var(--cacao-suave);font-weight:600;}
    .fila-detalle .valor{font-size:0.95rem;font-weight:700;text-align:right;}
    .grupo-detalles{
      border:2px solid var(--linea);
      border-radius:14px;
      padding:6px 18px;
      margin-bottom:24px;
      background:var(--hueso);
    }
    .nota{
      margin-top:6px;
      background:var(--sol-suave);
      border-radius:12px;
      padding:14px 18px;
      font-size:0.88rem;
      color:var(--cacao);
    }
    .total{
      display:flex;
      justify-content:space-between;
      align-items:center;
      background:var(--cacao);
      color:var(--hueso);
      border-radius:16px;
      padding:18px 22px;
      margin:24px 0 8px;
    }
    .total .txt{font-size:0.8rem;text-transform:uppercase;letter-spacing:0.1em;color:var(--sol-suave);font-weight:700;}
    .total .monto{font-family:var(--display);font-size:2rem;font-weight:700;color:var(--sol);}
    .total .monto small{font-size:0.85rem;color:var(--sol-suave);}
    .cliente{
      margin-top:22px;
      display:flex;
      flex-direction:column;
      gap:8px;
      font-size:0.9rem;
      color:var(--cacao-suave);
    }
    .cliente b{color:var(--cacao);}
    .acciones{
      display:flex;
      flex-direction:column;
      gap:12px;
      margin-top:26px;
    }
    .boton{
      display:block;
      text-align:center;
      padding:14px 20px;
      border-radius:50px;
      font-weight:700;
      font-size:0.95rem;
      border:2.5px solid var(--cacao);
      transition:all .2s;
    }
    .boton-wa{background:#25D366;border-color:#128C7E;color:#fff;}
    .boton-wa:hover{background:#1fb957;transform:translateY(-2px);}
    .boton-secundario{background:transparent;color:var(--cacao);}
    .boton-secundario:hover{background:var(--cacao);color:var(--hueso);}
    .pie{
      text-align:center;
      font-size:0.8rem;
      color:var(--cacao-suave);
      margin-top:28px;
    }
    .pie a{color:var(--rosa-osc);font-weight:700;text-decoration:underline;}
    @media(max-width:520px){
      body{padding:16px 10px 32px;}
      .cabecera{padding:26px 20px 22px;}
      .cuerpo{padding:22px 18px 26px;}
      .total .monto{font-size:1.6rem;}
    }
  </style>
</head>
<body>
  <div class="tarjeta">
    <div class="cabecera">
      <div class="marca">Elías Reyes y su Proyecto 7</div>
      <h1>Cotización de servicio</h1>
      <div class="subtitulo">Trío musical · Mérida, Yucatán</div>
      <div class="folio">Folio #<%= cot.id %> · <%= new Date(cot.creada).toLocaleDateString('es-MX', { day: 'numeric', month: 'long', year: 'numeric' }) %></div>
    </div>

    <div class="cuerpo">
      <% const etiquetas = {
            serenata: { icono: '🎵', nombre: 'Serenata', rapido: '4 canciones con guitarra y tres voces' },
            horas:    { icono: '⏱', nombre: 'Por hora', rapido: 'Música en vivo de primer nivel' },
            evento:   { icono: '🎉', nombre: 'Evento personalizado', rapido: 'Cotización a la medida' },
            chat:     { icono: '💬', nombre: 'Consulta por chat', rapido: 'Lead capturado por el asistente' }
          };
          const info = etiquetas[cot.tipo_servicio] || etiquetas.evento;
      %>
      <div class="servicio">
        <div class="icono"><%= info.icono %></div>
        <div>
          <div class="nombre"><%= info.nombre %></div>
          <div class="detalle-rapido"><%= info.rapido %></div>
        </div>
      </div>

      <div class="grupo-detalles">
        <% if (cot.tipo_servicio === 'serenata') { %>
          <div class="fila-detalle"><span class="clave">Canciones incluidas</span><span class="valor"><%= cot.detalles.canciones || 4 %></span></div>
          <div class="fila-detalle"><span class="clave">Fuera de Mérida</span><span class="valor"><%= cot.detalles.fuera_merida || 'No' %></span></div>
        <% } else if (cot.tipo_servicio === 'horas') { %>
          <div class="fila-detalle"><span class="clave">Horas contratadas</span><span class="valor"><%= cot.detalles.horas || 1 %> hr(s)</span></div>
        <% } else if (cot.tipo_servicio === 'evento') { %>
          <div class="fila-detalle"><span class="clave">Tipo de evento</span><span class="valor"><%= cot.detalles.tipo_evento || 'A definir' %></span></div>
          <div class="fila-detalle"><span class="clave">Horas estimadas</span><span class="valor"><%= cot.detalles.horas_estimadas || 'A definir' %> hr(s)</span></div>
        <% } %>
        <% if (cot.mensaje) { %>
          <div class="fila-detalle"><span class="clave">Tu mensaje</span><span class="valor" style="max-width:340px;text-align:left;font-weight:500;"><%= cot.mensaje %></span></div>
        <% } %>
      </div>

      <div class="total">
        <span class="txt">Total estimado</span>
        <% if (cot.tipo_servicio === 'evento') { %>
          <span class="monto">A convenir</span>
        <% } else { %>
          <span class="monto">$<%= Number(cot.precio_total).toLocaleString('es-MX') %> <small>MXN</small></span>
        <% } %>
      </div>

      <% if (cot.tipo_servicio === 'evento') { %>
        <div class="nota">🎯 Los eventos se cotizan de forma personalizada según duración, ubicación y tipo. Confirmamos el precio final después de conocerte.</div>
      <% } else { %>
        <div class="nota">💡 Este es un estimado preliminar. El precio final se confirma al acordar fecha y detalles del evento.</div>
      <% } %>

      <div class="cliente">
        <div>Cliente: <b><%= cot.cliente_nombre %></b></div>
        <% if (cot.cliente_telefono) { %><div>Teléfono: <b><%= cot.cliente_telefono %></b></div><% } %>
        <% if (cot.cliente_email) { %><div>Correo: <b><%= cot.cliente_email %></b></div><% } %>
      </div>

      <div class="acciones">
        <% const msj = encodeURIComponent('¡Hola! Quiero contratar mi ' + info.nombre + ' (folio #' + cot.id + '). Ya recibí mi cotización.'); %>
        <a class="boton boton-wa" href="https://wa.me/<%= WHATSAPP_NUM %>?text=<%= msj %>" target="_blank" rel="noopener">Confirmar por WhatsApp</a>
        <a class="boton boton-secundario" href="/">Volver al sitio</a>
      </div>
    </div>
  </div>

  <div class="pie">
    Elías Reyes y su Proyecto 7 · Mérida, Yucatán<br>
    <a href="/">eliasreyes.proyecto7</a>
  </div>
</body>
</html>
